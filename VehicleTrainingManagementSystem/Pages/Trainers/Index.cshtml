@page
@model VehicleTrainingManagementSystem.Pages.Trainers.IndexModel
@{
    ViewData["Title"] = "Trainers";
    Layout = "_Layout";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Trainers</h2>
    <a asp-page="Register" class="btn btn-primary">+ Register New Trainer</a>
</div>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Photo</th>
            <th>Name</th>
            <th>Phone</th>
            <th>National ID</th>
            <th>Training Type</th>
            <th>Status</th>
            <th>Start Date</th>
            <th>Registered By</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var row in Model.Rows)
        {
            <tr>
                <td>
                    @if (!string.IsNullOrEmpty(row.PhotoPath))
                    {
                        <img src="@row.PhotoPath" style="width:40px;height:40px;object-fit:cover;border-radius:50%;" />
                    }
                    else
                    {
                        <span class="text-muted">—</span>
                    }
                </td>
                <td>@row.TrainerName</td>
                <td>@row.Phone</td>
                <td>@row.NationalId</td>
                <td>@row.TrainingTypeName</td>
                <td>
                    <span class="badge bg-@row.StatusColor">@row.Status</span>
                </td>
                <td>@(row.StartDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                <td>@row.RegisteredBy</td>
                <td>
                    @if (row.Status == "InProgress" && User.IsInRole("Admin"))
                    {
                        <a asp-page="/Admin/Certificates/Issue" asp-route-sessionId="@row.SessionId" class="btn btn-sm btn-success">Issue Certificate</a>
                    }
                    else if (row.Status == "Completed")
                    {
                        <span class="text-muted small">Certified</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>